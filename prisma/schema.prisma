generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model admins {
  id                                                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_address                                     String           @unique
  added_by                                           String?          @db.Uuid
  added_at                                           DateTime         @default(now()) @db.Timestamptz(6)
  revoked_at                                         DateTime?        @db.Timestamptz(6)
  revoked_by                                         String?          @db.Uuid
  member_name                                        String?
  added_by_name                                      String?
  public_profiles_admins_added_byTopublic_profiles   public_profiles? @relation("admins_added_byTopublic_profiles", fields: [added_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles_admins_revoked_byTopublic_profiles public_profiles? @relation("admins_revoked_byTopublic_profiles", fields: [revoked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model attendance_records {
  id                                                              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                         String           @db.Uuid
  event_id                                                        String           @db.Uuid
  check_in_method                                                 String
  checked_in_at                                                   DateTime         @default(now()) @db.Timestamptz(6)
  verified_by                                                     String?          @db.Uuid
  verification_status                                             String           @default("verified")
  revoked_at                                                      DateTime?        @db.Timestamptz(6)
  revoked_by                                                      String?          @db.Uuid
  events                                                          events           @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles_attendance_records_revoked_byTopublic_profiles  public_profiles? @relation("attendance_records_revoked_byTopublic_profiles", fields: [revoked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles_attendance_records_user_idTopublic_profiles     public_profiles  @relation("attendance_records_user_idTopublic_profiles", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles_attendance_records_verified_byTopublic_profiles public_profiles? @relation("attendance_records_verified_byTopublic_profiles", fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_badges                                                   member_badges?

  @@unique([user_id, event_id])
  @@index([event_id], map: "idx_attendance_event")
  @@index([user_id], map: "idx_attendance_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id   String?          @db.Uuid
  action_type     String
  target_type     String
  target_id       String?          @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  metadata        Json?
  public_profiles public_profiles? @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_user_id], map: "idx_audit_actor")
  @@index([target_type, target_id], map: "idx_audit_target")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model badges {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  name            String
  description     String?
  imageurl        String?
  category        badge_enum?
  criteria        String?
  eventid         String?          @unique @db.Uuid
  isactive        Boolean          @default(true)
  revokedat       DateTime?        @db.Timestamptz(6)
  revokedby       String?          @db.Uuid
  events          events?          @relation(fields: [eventid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles public_profiles? @relation(fields: [revokedby], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member_badges   member_badges[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_registrations {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String          @db.Uuid
  event_id        String          @db.Uuid
  registered_at   DateTime        @default(now()) @db.Timestamptz(6)
  events          events          @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles public_profiles @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, event_id])
  @@index([event_id], map: "idx_registration_event")
  @@index([user_id], map: "idx_registration_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  description         String?
  start_time          DateTime              @db.Timestamptz(6)
  end_time            DateTime              @db.Timestamptz(6)
  check_in_open_time  DateTime?             @db.Timestamptz(6)
  check_in_close_time DateTime?             @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  event_url           String?
  event_path          String?
  location            String?
  capacity            Int?
  attendance_records  attendance_records[]
  badges              badges?
  event_registrations event_registrations[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model member_badges {
  id                                                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  badgeid                                                  String             @db.Uuid
  memberid                                                 String             @db.Uuid
  attendanceid                                             String             @unique @db.Uuid
  awardedat                                                DateTime           @default(now()) @db.Timestamptz(6)
  revokedat                                                DateTime?          @db.Timestamptz(6)
  revokedby                                                String?            @db.Uuid
  attendance_records                                       attendance_records @relation(fields: [attendanceid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  badges                                                   badges             @relation(fields: [badgeid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles_member_badges_memberidTopublic_profiles  public_profiles    @relation("member_badges_memberidTopublic_profiles", fields: [memberid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  public_profiles_member_badges_revokedbyTopublic_profiles public_profiles?   @relation("member_badges_revokedbyTopublic_profiles", fields: [revokedby], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([memberid, badgeid])
  @@index([badgeid], map: "idx_member_badges_badge")
  @@index([memberid], map: "idx_member_badges_member")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model public_profiles {
  id                                                                 String                @id @default(dbgenerated("extensions.gen_random_uuid()")) @db.Uuid
  registration_id                                                    BigInt                @unique
  display_name                                                       String
  unique_name                                                        String?
  profile_picture_url                                                String?
  wallet_suffix                                                      String
  badges                                                             String[]              @default([])
  events_attended                                                    String[]              @default([])
  search_text                                                        String
  created_at                                                         DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                                         DateTime              @default(now()) @db.Timestamptz(6)
  qr_secret                                                          String?               @unique
  admins_admins_added_byTopublic_profiles                            admins[]              @relation("admins_added_byTopublic_profiles")
  admins_admins_revoked_byTopublic_profiles                          admins[]              @relation("admins_revoked_byTopublic_profiles")
  attendance_records_attendance_records_revoked_byTopublic_profiles  attendance_records[]  @relation("attendance_records_revoked_byTopublic_profiles")
  attendance_records_attendance_records_user_idTopublic_profiles     attendance_records[]  @relation("attendance_records_user_idTopublic_profiles")
  attendance_records_attendance_records_verified_byTopublic_profiles attendance_records[]  @relation("attendance_records_verified_byTopublic_profiles")
  audit_logs                                                         audit_logs[]
  revoked_badges                                                             badges[]
  event_registrations                                                event_registrations[]
  member_badges_member_badges_memberidTopublic_profiles              member_badges[]       @relation("member_badges_memberidTopublic_profiles")
  member_badges_member_badges_revokedbyTopublic_profiles             member_badges[]       @relation("member_badges_revokedbyTopublic_profiles")
  registrations                                                      registrations         @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([search_text(ops: raw("gin_trgm_ops"))], map: "public_profiles_search_text_trgm_idx", type: Gin)
  @@index([wallet_suffix])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model registrations {
  id                   BigInt           @id @default(autoincrement())
  first_name           String
  last_name            String
  email                String
  university           uni_enum
  university_other     String?
  upi                  String?
  student_id           BigInt?
  degree_type          degree_enum?
  faculty              faculty_enum?
  goal_statement       String?
  created_at           DateTime?        @default(now()) @db.Timestamptz(6)
  wallet_id            String?
  ens                  String?
  unique_name          String?
  profile_picture_path String?
  profile_picture_url  String?
  badges               String[]         @default([])
  events_attended      String[]         @default([])
  profile_visible      Boolean          @default(true)
  public_profiles      public_profiles?
}

model ClaimRequest {
  id            String   @id @default(uuid())
  walletAddress String
  requestedName String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([walletAddress, status])
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum badge_enum {
  EVENT
  ACHIEVEMENT
  SPECIAL
}

enum degree_enum {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR
  FOURTH_ABOVE
  MASTER
  PHD
}

enum faculty_enum {
  ARTS
  COMMERCE
  ENGINEERING
  SCIENCE
  OTHER
  LAW
  MEDICAL___HEALTH @map("MEDICAL & HEALTH")
}

enum uni_enum {
  UOA
  AUT
  NONE
  OTHER
}
